# DecisionLens environment template.
#
# Copy to .env and fill in only what you need. .env is gitignored.
#
#     cp .env.example .env
#
# No API key is required. The default run replays recorded model output through
# the cached provider: offline, free, and identical every time. A key is needed
# only to run the same workflow against a live model.
#
# Going live takes BOTH lines below. A key on its own changes nothing —
# DecisionLens never switches to a paid provider because it found a credential.
#
# Never commit real credentials. Leave every value blank in this file.

ANTHROPIC_API_KEY=

# cached | anthropic          (blank means cached)
MODEL_PROVIDER=

# Blank uses the default model for the selected provider.
MODEL_NAME=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
