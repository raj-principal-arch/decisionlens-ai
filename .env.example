# DecisionLens environment template.
#
# Copy to .env and fill in only what you need. .env is gitignored.
#
# No API key is required to run DecisionLens. The bundled demo uses a
# deterministic cached provider (Phase 5) so a reviewer can run the prototype
# offline. Keys are needed only to execute live model comparisons.
#
# Never commit real credentials. Leave every value blank in this file.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider to use: cached | anthropic | openai
MODEL_PROVIDER=

# Model identifier for the selected provider.
MODEL_NAME=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
